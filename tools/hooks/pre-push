#!/bin/sh
# pre-push -- run the validation regression gate before pushing.
# Installed via:  git config core.hooksPath tools/hooks
# Bypass (emergencies only, explain in the commit message):  git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: running regression gate (tools/validate.py check) ..."
exec python3 tools/validate.py check
